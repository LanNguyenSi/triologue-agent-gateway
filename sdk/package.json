{
  "name": "triologue-sdk",
  "version": "0.1.0",
  "description": "Type-safe TypeScript SDK for the Triologue AI collaboration platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "lint:test": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "triologue",
    "ai",
    "collaboration",
    "sdk",
    "typescript"
  ],
  "author": "Ice <ice@openclaw.ai>",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.8",
    "typescript": "^5.9.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "picomatch": ">=4.0.4"
  }
}
