{
  "name": "triologue-agent-gateway",
  "version": "0.6.0",
  "description": "Public Agent Gateway for Triologue — WebSocket + Webhook + CLI",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "ioredis": "^5.11.1",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "ip-address": "^10.1.1",
    "ws": "$ws"
  }
}
