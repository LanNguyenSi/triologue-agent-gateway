[Unit]
Description=Triologue Agent Gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/triologue-agent-gateway
ExecStart=/usr/bin/npx tsx src/index.ts
Restart=always
RestartSec=10
Environment=NODE_ENV=production
EnvironmentFile=/opt/triologue-agent-gateway/.env

[Install]
WantedBy=multi-user.target
