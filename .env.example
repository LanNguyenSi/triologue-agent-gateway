# Keep every assignment on its own line without a trailing comment: systemd
# EnvironmentFile and docker --env-file treat "# ..." after a value as part
# of the value.
PORT=9500
TRIOLOGUE_URL=http://localhost:4001
# BYOA token of the gateway service account (see docs/configuration.md#gateway-account)
GATEWAY_TOKEN=byoa_xxx
GATEWAY_USERNAME=gateway
AGENTS_CONFIG=./agents.json
# Redis for SSE idempotency and replay; unset uses the default below.
# REDIS_URL=redis://localhost:6379
# Directory for the read tracker, metrics log and JWT cache. It must exist and
# be writable by the gateway process. Unset keeps the project root (next to
# dist/); the Docker image sets /app/state.
# STATE_DIR=/var/lib/triologue-agent-gateway

# Base directory of a local OpenClaw install, used only by agents with
# delivery "openclaw-inject" (reads openclaw.json and identity/device.json,
# and names workspace/send-to-triologue.sh in the reply hint). Unset keeps
# the historical default /root/.openclaw.
# OPENCLAW_HOME=/root/.openclaw
# Used only when $OPENCLAW_HOME/openclaw.json cannot be read.
# OPENCLAW_GATEWAY_TOKEN=

# ── agent-tasks → Triologue bridge (optional) ─────────────────────────────
# The whole bridge is optional. The /agent-tasks/webhook route returns 503
# feature_disabled unless AGENT_TASKS_BOT_TOKEN and AGENT_TASKS_INBOX_ROOM_ID
# are both set AND auth is configured: either AGENT_TASKS_WEBHOOK_SECRET
# (HMAC verification) or AGENT_TASKS_WEBHOOK_ALLOW_UNSIGNED=true. Without
# one of the two the bridge stays disabled (fail-closed). See
# docs/agent-tasks-bridge.md for the full setup.
# BYOA token for the dedicated "agent-tasks-bot" identity
AGENT_TASKS_BOT_TOKEN=
# Triologue room where signal messages get posted
AGENT_TASKS_INBOX_ROOM_ID=
# Shared HMAC secret matching the project's notificationWebhookSecret (required unless ALLOW_UNSIGNED=true)
AGENT_TASKS_WEBHOOK_SECRET=
# WARNING: "true" accepts unauthenticated webhooks; anyone who can reach the URL can post into the inbox room.
# AGENT_TASKS_WEBHOOK_ALLOW_UNSIGNED=false
# Used for "open task" deep-links inside the formatted message
AGENT_TASKS_BASE_URL=https://agent-tasks.opentriologue.ai
